# ---- 必須（Vercel の Environment Variables に設定）----
# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 初期管理者の登録に使うコード（16文字以上のランダムな文字列。登録後は変更・削除してよい）
SUPPORTYOU_SETUP_CODE=
# サイトの正式URL（メール内リンクに使用）
SUPPORTYOU_SITE_URL=https://example.vercel.app

# ---- 施設情報（画面・メールに表示）----
NEXT_PUBLIC_FACILITY_NAME=病児保育室 Support you（養老）
NEXT_PUBLIC_FACILITY_SHORT_NAME=Support you
NEXT_PUBLIC_FACILITY_OPERATOR=有限会社ライフ・エスコート
NEXT_PUBLIC_FACILITY_PHONE=
NEXT_PUBLIC_FACILITY_ADDRESS=

# ---- 任意：メール通知（Resend）----
RESEND_API_KEY=
SUPPORTYOU_MAIL_FROM="Support you <noreply@your-domain.jp>"
# 新しい申込み・書類提出・取消し申出などを受け取る施設のアドレス
SUPPORTYOU_FACILITY_EMAIL=
