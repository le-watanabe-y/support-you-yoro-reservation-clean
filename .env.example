# ---- 必須（Vercel の Environment Variables に設定）----
# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 本部管理者（最初の1人）の登録に使うコード（16文字以上のランダムな文字列。登録後は変更・削除してよい）
SUPPORTYOU_SETUP_CODE=
# サイトの正式URL（メール内リンクに使用）
SUPPORTYOU_SITE_URL=https://example.vercel.app

# ---- 運営会社の情報（画面・メールに表示）----
# 施設ごとの名称・電話・住所・ハウスルールは、職員画面の「ハウスルール」で施設ごとに設定します。
NEXT_PUBLIC_SERVICE_NAME=Support you 病児保育予約
NEXT_PUBLIC_OPERATOR_NAME=有限会社ライフ・エスコート
NEXT_PUBLIC_OPERATOR_CONTACT=

# ---- 任意：メール通知（Resend）----
RESEND_API_KEY=
SUPPORTYOU_MAIL_FROM="Support you <noreply@your-domain.jp>"
# 施設の通知先メールを「ハウスルール」で設定していない場合の予備の宛先（任意）
SUPPORTYOU_FACILITY_EMAIL=
